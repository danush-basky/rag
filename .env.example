############################
# 🤖 LLM Configuration
############################
LLM_PROVIDER_URL=https://openrouter.ai/api/v1
LLM_API_KEY=api-key
LLM_MODEL=openai/gpt-5.6-luna
MAX_TOKENS=10096
TEMPERATURE=0.4


############################
# 🔗 Embeddings
############################
EMBEDDING_PROVIDER_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=google/gemini-embedding-001
EMBEDDING_DIMENSIONS=1024


############################
# 🧠 Reranker
############################
RERANKER_ENABLE=true
RERANKER_PROVIDER_URL=https://openrouter.ai/api/v1
RERANKER_MODEL=cohere/rerank-4-fast
RERANK_TOP_K=5
RERANK_SCORE_THRESHOLD=0.35


############################
# 📚 RAG Settings
############################
CHUNK_SIZE=1200
CHUNK_OVERLAP=250
TOP_K_RETRIEVAL=25
HYBRID_ALPHA=0.5


############################
# 📊 LangFuse
############################
LANGFUSE_SECRET_KEY=api-key
LANGFUSE_PUBLIC_KEY=api-key
LANGFUSE_BASE_URL="https://cloud.langfuse.com"


############################
# 🗄️ Database Configuration
############################
DB_HOST=172.17.0.1
DB_PORT=5432
DB_NAME=rag_database
DB_USER=postgres
DB_PASSWORD=admin
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10


############################
# 🧾 Chat History & Summarization
############################
HISTORY_TABLE=chat_messages_history
SUMMARY_TABLE=chat_session_summaries

MAX_HISTORY_MESSAGES=10
SUMMARY_INTERVAL=5
SUMMARY_MODEL=google/gemini-3.1-flash-lite
SUMMARY_MAX_TOKENS=512

JEE_SYSTEM_PROMPT_PATH=app/prompts/jee_system_prompt.md
JEE_CONTEXT_PROMPT_PATH=app/prompts/jee_context_prompt.md